{
  "name": "@trench-xinxin/dsh-tool-lens",
  "description": "DeepSeek Lens: Deep AST code graph, symbol call hierarchies, and refactoring impact analysis tool plugin for DeepSeek Harness",
  "version": "1.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0409wx/dsh-tool-lens.git"
  },
  "homepage": "https://github.com/0409wx/dsh-tool-lens#readme",
  "bugs": {
    "url": "https://github.com/0409wx/dsh-tool-lens/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsdown"
  },
  "bin": {
    "dsh-tool-lens": "./bin/dsh-lens.js",
    "dsh-lens": "./bin/dsh-lens.js",
    "lens": "./bin/dsh-lens.js"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "lib/index.d.mts",
    "lib/invariant.d.mts",
    "bin/dsh-lens.js",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
